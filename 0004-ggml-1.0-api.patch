From: OpenMandriva
Subject: [PATCH] Follow the ggml 1.0 precision and mask API

ggml_mul_mat_set_prec and ggml_flash_attn_ext_set_prec are gone;
use ggml_prec_set_acc. diag_mask_inf(zeros, 0) is a strict upper
-inf triangle, which ggml_fill plus ggml_tri(UPPER) builds.

--- a/src/core/ggml_extend.hpp
+++ b/src/core/ggml_extend.hpp
@@ -1054,13 +1054,13 @@
         x           = ggml_reshape_2d(ctx, x, x->ne[0], x->ne[1] * x->ne[2] * x->ne[3]);
         x           = ggml_mul_mat(ctx, w, x);
         if (force_prec_f32) {
-            ggml_mul_mat_set_prec(x, GGML_PREC_F32);
+            ggml_prec_set_acc(x, GGML_PREC_F32);
         }
         x = ggml_reshape_4d(ctx, x, x->ne[0], x->ne[1] / ne2 / ne3, ne2, ne3);
     } else {
         x = ggml_mul_mat(ctx, w, x);
         if (force_prec_f32) {
-            ggml_mul_mat_set_prec(x, GGML_PREC_F32);
+            ggml_prec_set_acc(x, GGML_PREC_F32);
         }
     }
     if (scale != 1.f) {
@@ -1231,7 +1231,7 @@
         x          = ggml_mul_mat(ctx,
